# Backend's API base URL, e.g.:
# https://api.yourdomain.com/api/v1
BACKEND_URL=

PORT=5001
NODE_ENV=production
SIMULATION_INTERVAL=10000
AUTO_START=false

# Must match the backend's SENSOR_API_KEY exactly.
SENSOR_API_KEY=

SITE_ID=site-reserve-kaa

# Comma-separated list of allowed origins for this service's own endpoints.
# Not called directly from the browser anymore (the dashboard proxies
# simulator control through the backend) — mostly relevant for direct/manual
# testing against this service.
CORS_ORIGIN=
