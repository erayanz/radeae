# Backend's API base URL, e.g.:
# https://api.yourdomain.com/api/v1
VITE_API_URL=

VITE_GOOGLE_MAPS_API_KEY=

# NOTE: these are baked into the static build at *build time* (Vite), not
# read at runtime. On Cloudflare Pages, set them as the Pages project's
# build environment variables — editing them requires a rebuild/redeploy to
# take effect, not just a page reload.
