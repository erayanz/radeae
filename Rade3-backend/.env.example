PORT=5000
NODE_ENV=production
API_VERSION=v1

# Auth — generate real, unique values for production. Do not reuse dev values.
JWT_SECRET=
SENSOR_API_KEY=
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Comma-separated list of allowed frontend origins, e.g.:
# https://app.yourdomain.com
CORS_ORIGIN=

# AI classification microservice (RadeaeAIModel/inference_api) — leave unset
# unless that service is deployed too; the /api/v1/classification/* routes
# will just fail gracefully (502) if this points nowhere.
INFERENCE_API_URL=

# Sensor simulator service — set to the simulator's deployed URL, e.g.:
# https://sim.yourdomain.com
SIMULATOR_API_URL=
